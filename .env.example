# LAMSA — environment variables (NO real values here; never commit real secrets)
#
# ── Cloudflare Pages → Settings → Variables and Secrets (Production + Preview) ──
# Secret. Random 64-hex string shared with Supabase (same value on both sides).
# Generate: openssl rand -hex 32
LAMSA_WOW_GATEWAY_SECRET=
# Plain. Optional — Cloudflare Turnstile site key (bot protection on order + writing helper).
TURNSTILE_SITE_KEY=
# Plain. Optional overrides (defaults are the current project).
SUPABASE_URL=https://qwavanugzcjevhtzjfuo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_public_anon_key
# Plain. "false" turns WOW/games endpoints off without a redeploy.
WOW_ENABLED=true

# ── Supabase → Project Settings → Edge Functions → Secrets ──
# Same value as Cloudflare's LAMSA_WOW_GATEWAY_SECRET.
LAMSA_WOW_GATEWAY_SECRET=
# Production origin allowed by CORS.
ALLOWED_ORIGIN=https://lamsagift.pages.dev
# Optional: Turnstile secret (if set, create-order REQUIRES a Turnstile token).
TURNSTILE_SECRET_KEY=
# Optional: "true" makes create-order refuse calls that do not come through the Worker.
REQUIRE_LAMSA_GATEWAY=true
# Optional: writing helper (wow-rewrite).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Provided automatically by Supabase — do not set manually:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY(S)
