# LAMSA — environment variables. NO real values here; never commit real secrets.
# Full steps: DEPLOYMENT.md

# ── Cloudflare Pages → Settings → Variables and Secrets (Production + Preview) ──
NODE_VERSION=22
SUPABASE_URL=https://<project-ref>.supabase.co       # plain
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...          # plain (public by design, protected by RLS)
SITE_URL=https://lamsa-eg.pages.dev                  # plain
LAMSA_WOW_GATEWAY_SECRET=                            # SECRET — openssl rand -hex 32 (same value in Supabase)
TURNSTILE_SITE_KEY=                                  # plain, optional (only together with TURNSTILE_SECRET_KEY)
WOW_ENABLED=true                                     # plain, optional ("false" turns games off)

# ── Supabase → Edge Functions → Secrets  (npx supabase secrets set KEY=value) ──
LAMSA_WOW_GATEWAY_SECRET=                            # same value as Cloudflare
ALLOWED_ORIGIN=https://lamsa-eg.pages.dev
REQUIRE_LAMSA_GATEWAY=true                           # functions refuse calls that skip the Worker
OWNER_SETUP_CODE=                                    # openssl rand -hex 16 — delete after the owner account exists
NOTIFY_EMAIL=                                        # optional, contact for web-push (VAPID)
TURNSTILE_SECRET_KEY=                                # optional
ANTHROPIC_API_KEY=                                   # optional, writing helper
ANTHROPIC_MODEL=                                     # optional
# Provided automatically by Supabase (never set by hand, never put in the frontend):
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY(S)
