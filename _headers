# LAMSA v38 — Cloudflare Pages headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), nfc=(self), payment=()
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://qwavanugzcjevhtzjfuo.supabase.co https://qwavanugzcjevhtzjfuo.storage.supabase.co https://i.ytimg.com; media-src 'self' blob: https://qwavanugzcjevhtzjfuo.supabase.co https://qwavanugzcjevhtzjfuo.storage.supabase.co; connect-src 'self' https://qwavanugzcjevhtzjfuo.supabase.co https://qwavanugzcjevhtzjfuo.storage.supabase.co wss://qwavanugzcjevhtzjfuo.supabase.co https://challenges.cloudflare.com https://cdn.jsdelivr.net; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.tiktok.com https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# HTML: always revalidate so a deploy is visible immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Private pages: never cached, never indexed
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
/m/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
/memory.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
/order
  Cache-Control: no-store
/order.html
  Cache-Control: no-store
/order-success.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/track.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/upload/*
  Cache-Control: no-store

# Code: cheap revalidation (ETag/304) — module imports are not hashed, so no long cache
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Static media: long cache
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/demo/*
  Cache-Control: public, max-age=604800
/assets/wow-demo/*
  Cache-Control: public, max-age=604800
/assets/audio/*
  Cache-Control: public, max-age=604800

/sw-v18.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/site.webmanifest
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: no-cache
